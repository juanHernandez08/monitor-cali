# Copia este archivo a .env y completa lo que tengas. Todo lo vacío se omite sin romper nada.

DATABASE_URL=sqlite:///monitor.db

# Login del dashboard (HTTP Basic). OBLIGATORIO en la nube: sin esto, la URL pública queda sin
# ninguna barrera y cualquiera ve menciones, sentimiento y estrategia de campaña. En desarrollo
# local se puede dejar vacío (el sitio sigue abierto, como hasta ahora).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Sentimiento: "ollama" (local, gratis, requiere Ollama corriendo) o "claude" (requiere ANTHROPIC_API_KEY)
SENTIMENT_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Cloud (gratis, sin tarjeta): habilitar "Custom Search API" y "YouTube Data API v3"
# GOOGLE_CSE_ID sale de https://programmablesearchengine.google.com (motor con "Buscar en toda la Web")
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_DAILY_LIMIT=95

# Bright Data — Instagram/Facebook por cuenta (posts + comentarios). Plan gratuito: 5.000 registros/mes.
# Panel → Configuración → API keys. El SDK NO debe crear zonas (ya está desactivado en el código).
BRIGHTDATA_API_TOKEN=
SOCIAL_WINDOW_DAYS=60
SOCIAL_MAX_POSTS=40
SOCIAL_MAX_COMMENTS=30
SOCIAL_COMMENT_POSTS=4
BRIGHTDATA_MONTHLY_CREDITS=4000

# Apify (gratis USD 5/mes, sin tarjeta): X con posts y respuestas. Settings → Integrations → API token.
APIFY_TOKEN=
APIFY_MONTHLY_ITEMS=10000
