# Copia este archivo a .env y completa lo que tengas. Todo lo vacío se omite sin romper nada.

DATABASE_URL=sqlite:///monitor.db

# Sentimiento: "ollama" (local, gratis, requiere Ollama corriendo) o "claude" (requiere ANTHROPIC_API_KEY)
SENTIMENT_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Cloud (gratis, sin tarjeta): habilitar "Custom Search API" y "YouTube Data API v3"
# GOOGLE_CSE_ID sale de https://programmablesearchengine.google.com (motor con "Buscar en toda la Web")
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_DAILY_LIMIT=95

# Bright Data (de pago, opcional — activa los conectores Reddit/SERP de pago)
BRIGHTDATA_API_TOKEN=
